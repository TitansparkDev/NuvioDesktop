 constexpr std::uint64_t rolling_selection_limit = 1024 * 1024 * 1024;
 constexpr std::uint64_t critical_front_limit = 1024 * 1024;
 
+// Nuvio desktop tuning. libtorrent's time-critical requester hands the whole blocking piece to
+// whichever peers exist the moment the deadline is set, and its "busy mode" (re-request a
+// stalled block elsewhere) is gated on an average piece time that is zero until a piece has
+// completed in the session. On a cold or warm-from-disk engine the first hole a seek lands in
+// is therefore fetched entirely by the two slow peers that answered first, while fast seeds
+// that arrive seconds later fill readahead around it - measured at 38-170 s for one 16 MiB
+// piece at 90 Mbps aggregate. The normal picker has no such trap: per-peer queues stay bounded,
+// so a top-priority piece's free blocks go to whoever is fastest now. So by default blocking
+// pieces are plain top-priority pieces, and completion is learned from piece_finished_alert
+// instead of set_piece_deadline's alert_when_available.
+//
+// Update: with run_blocking_hotswap() below the trap is gone (slow holders get their blocks
+// force-cancelled, and the time-critical requester re-issues them to the fastest peers), and
+// deadlines are worth keeping because they put the blocking piece's blocks at the FRONT of a
+// peer's queue - the normal picker appends them behind up to 16 MB of readahead, which cost a
+// full queue drain per reassigned tail (measured ~15 s per hole seek). Default is therefore
+// deadlines on; NUVIO_ENGINE_PIECE_DEADLINES=0 switches to the plain picker for comparison.
+const bool use_piece_deadlines = [] {
+    const char* value = std::getenv("NUVIO_ENGINE_PIECE_DEADLINES");
+    return value == nullptr || value[0] != '0';
+}();
+
 std::string torrent_id(const lt::torrent_handle& handle) {
     const auto hashes = handle.info_hashes();
     if (hashes.has_v1()) {
@@ -600,6 +632,167 @@ struct LibtorrentStreamBridge::Impl {
             recompute_schedule(id);
         }
         expire_inactive_streams();
+        run_blocking_hotswap();
+        debug_dump_blocking_pieces();
+    }
+
+    // Nuvio desktop: hotswap for the piece the player is waiting on. libtorrent never issues a
+    // duplicate request outside end-game/time-critical busy mode, so once slow peers hold every
+    // block of the blocking piece a fast seed that connects later cannot touch it (it shows
+    // free=0 and the fast peer fills readahead instead - measured 30-170 s per 16 MiB piece).
+    // Stremio's torrent-stream solves this with "hotswap": cancel the slow peer's requests and
+    // let the fast one re-pick them. libtorrent has no public cancel, so this walks the
+    // internal torrent on the session thread, the same way its own cancel_non_critical_pieces
+    // does, and force-cancels blocks of the blocking piece held by any peer at least 4x slower
+    // than the fastest unchoked one. The freed blocks are top-priority partials, so they are the
+    // next thing every peer requests.
+    struct HotswapState {
+        std::uint32_t piece = std::numeric_limits<std::uint32_t>::max();
+        std::chrono::steady_clock::time_point since{};
+        std::chrono::steady_clock::time_point last_swap{};
+    };
+    std::unordered_map<std::string, HotswapState> hotswap_state;
+    static constexpr auto hotswap_grace = std::chrono::seconds(2);
+    static constexpr auto hotswap_interval = std::chrono::seconds(1);
+    static constexpr int hotswap_fast_floor_bytes_per_second = 512 * 1024;
+    static constexpr int hotswap_ratio = 4;
+
+    void run_blocking_hotswap() {
+        const auto now = std::chrono::steady_clock::now();
+        for (const auto& [id, schedule] : current_schedules) {
+            if (schedule.blocking_deadline_order.empty()) {
+                hotswap_state.erase(id);
+                continue;
+            }
+            const auto piece = schedule.blocking_deadline_order.front();
+            auto& state = hotswap_state[id];
+            if (state.piece != piece) {
+                state = HotswapState{piece, now, {}};
+                continue;
+            }
+            if (now - state.since < hotswap_grace ||
+                (state.last_swap.time_since_epoch().count() != 0 &&
+                 now - state.last_swap < hotswap_interval)) {
+                continue;
+            }
+            state.last_swap = now;
+            std::shared_ptr<lt::torrent> torrent;
+            try {
+                torrent = schedule.handle.native_handle();
+            } catch (...) {
+                continue;
+            }
+            if (!torrent) continue;
+            const lt::piece_index_t target(static_cast<int>(piece));
+            const auto flags = piece_waiters.contains(PieceKey{id, piece})
+                ? lt::torrent_handle::alert_when_available
+                : lt::deadline_flags_t{};
+            boost::asio::post(torrent->session().get_context(), [torrent, target, flags] {
+                if (!torrent->valid_metadata() || !torrent->has_picker()) return;
+                int fastest = 0;
+                for (auto* peer : *torrent) {
+                    if (peer == nullptr || peer->is_disconnecting() || peer->has_peer_choked()) continue;
+                    fastest = std::max(fastest, peer->download_payload_rate());
+                }
+                if (fastest < hotswap_fast_floor_bytes_per_second) return;
+                for (auto* peer : *torrent) {
+                    if (peer == nullptr || peer->is_disconnecting()) continue;
+                    if (peer->download_payload_rate() * hotswap_ratio >= fastest) continue;
+                    // copies: cancel_request mutates the queues we are walking
+                    const std::vector<lt::pending_block> dq = peer->download_queue();
+                    for (const auto& k : dq) {
+                        if (k.block.piece_index != target || k.not_wanted) continue;
+                        peer->cancel_request(k.block, true);
+                    }
+                    const std::vector<lt::pending_block> rq = peer->request_queue();
+                    for (const auto& k : rq) {
+                        if (k.block.piece_index != target) continue;
+                        peer->cancel_request(k.block, true);
+                    }
+                }
+                // Promote whatever is still outstanding on the piece to the FRONT of its
+                // holder's queue - the same step set_piece_deadline performs on a fresh insert
+                // (it is a no-op for a piece already on the deadline list). Without it a fast
+                // peer that re-picked freed blocks through its normal request path served them
+                // behind up to 32 MB of readahead. Blocks nobody has re-picked yet go to the
+                // fastest peers on libtorrent's next tick.
+                static_cast<void>(flags);
+                const auto downloaders = torrent->picker().get_downloaders(target);
+                int block = 0;
+                for (auto* tp : downloaders) {
+                    if (tp != nullptr && tp->connection != nullptr) {
+                        static_cast<lt::peer_connection*>(tp->connection)
+                            ->make_time_critical(lt::piece_block(target, block));
+                    }
+                    ++block;
+                }
+            });
+        }
+    }
+
+    // NUVIO_ENGINE_DEBUG_BLOCKING=1: once a second, print libtorrent's view of each current
+    // blocking piece to stderr - block states, which peers hold its outstanding requests, and
+    // the fastest peers' rates. Diagnostic only.
+    std::chrono::steady_clock::time_point next_debug_dump{};
+    void debug_dump_blocking_pieces() {
+        // Value is a file path (append); "1" means stderr. Native stderr is invisible inside a
+        // JVM test harness, hence the file option.
+        static FILE* const sink = [] () -> FILE* {
+            const char* v = std::getenv("NUVIO_ENGINE_DEBUG_BLOCKING");
+            if (v == nullptr || v[0] == '\0') return nullptr;
+            if (v[0] == '1' && v[1] == '\0') return stderr;
+            return std::fopen(v, "a");
+        }();
+        if (sink == nullptr) return;
+        const auto now = std::chrono::steady_clock::now();
+        if (now < next_debug_dump) return;
+        next_debug_dump = now + std::chrono::seconds(1);
+        for (const auto& [id, schedule] : current_schedules) {
+            if (schedule.blocking_deadline_order.empty()) continue;
+            const auto piece = schedule.blocking_deadline_order.front();
+            try {
+                std::vector<lt::partial_piece_info> queue;
+                schedule.handle.get_download_queue(queue);
+                std::fprintf(sink, "[blocking] torrent=%.12s piece=%u partials=%zu prio=%d have=%d\n",
+                    id.c_str(), piece, queue.size(),
+                    static_cast<int>(schedule.handle.piece_priority(lt::piece_index_t(static_cast<int>(piece)))),
+                    schedule.handle.have_piece(lt::piece_index_t(static_cast<int>(piece))) ? 1 : 0);
+                for (const auto& p : queue) {
+                    if (static_cast<int>(p.piece_index) != static_cast<int>(piece)) continue;
+                    int none = 0, requested = 0, writing = 0, finished = 0;
+                    std::map<std::string, int> holders;
+                    for (int i = 0; i < p.blocks_in_piece; ++i) {
+                        const auto& blk = p.blocks[i];
+                        switch (blk.state) {
+                        case lt::block_info::none: ++none; break;
+                        case lt::block_info::requested: ++requested; holders[blk.peer().address().to_string() + ":" + std::to_string(blk.peer().port())] += 1; break;
+                        case lt::block_info::writing: ++writing; break;
+                        case lt::block_info::finished: ++finished; break;
+                        }
+                    }
+                    std::fprintf(sink, "[blocking]   blocks=%d free=%d requested=%d writing=%d finished=%d holders=%zu\n",
+                        p.blocks_in_piece, none, requested, writing, finished, holders.size());
+                    for (const auto& [peer, n] : holders) std::fprintf(sink, "[blocking]     %s holds %d\n", peer.c_str(), n);
+                }
+                std::vector<lt::peer_info> peers;
+                schedule.handle.get_peer_info(peers);
+                std::sort(peers.begin(), peers.end(), [](const auto& a, const auto& b) { return a.payload_down_speed > b.payload_down_speed; });
+                int shown = 0;
+                for (const auto& pi : peers) {
+                    if (shown++ >= 6) break;
+                    std::fprintf(sink, "[blocking]   peer %s:%d down=%dKB/s dq=%d rq=%d choked=%d interested=%d seed=%d snubbed=%d dlpiece=%d\n",
+                        pi.ip.address().to_string().c_str(), pi.ip.port(), pi.payload_down_speed / 1024,
+                        pi.download_queue_length, pi.upload_queue_length,
+                        (pi.flags & lt::peer_info::remote_choked) ? 1 : 0,
+                        (pi.flags & lt::peer_info::interesting) ? 1 : 0,
+                        (pi.flags & lt::peer_info::seed) ? 1 : 0,
+                        (pi.flags & lt::peer_info::snubbed) ? 1 : 0,
+                        static_cast<int>(pi.downloading_piece_index));
+                }
+            } catch (...) {
+            }
+        }
+        std::fflush(sink);
     }
 
     void expire_inactive_streams() {
@@ -700,6 +893,34 @@ struct LibtorrentStreamBridge::Impl {
             return;
         }
         piece_waiters[key].push_back(command.waiter);
+        if (!use_piece_deadlines) {
+            try {
+                if (command.route.handle.have_piece(lt::piece_index_t(static_cast<int>(command.piece)))) {
+                    command.route.handle.read_piece(lt::piece_index_t(static_cast<int>(command.piece)));
+                }
+            } catch (...) {
+            }
+        }
+    }
+
+    void handle_piece_finished(const lt::piece_finished_alert& alert) {
+        if (use_piece_deadlines) {
+            return;
+        }
+        const PieceKey key{
+            torrent_id(alert.handle),
+            static_cast<std::uint32_t>(static_cast<int>(alert.piece_index)),
+        };
+        if (!piece_waiters.contains(key)) {
+            return;
+        }
+        try {
+            alert.handle.read_piece(alert.piece_index);
+        } catch (const std::exception& error) {
+            fail_piece(key, error.what());
+        } catch (...) {
+            fail_piece(key, "failed to read finished piece");
+        }
     }
 
     void recompute_schedule(const std::string& id) {
@@ -811,7 +1032,7 @@ struct LibtorrentStreamBridge::Impl {
         } catch (...) {
         }
         for (std::size_t ordinal = 0;
-             ordinal < plan.blocking_deadline_order.size();
+             use_piece_deadlines && ordinal < plan.blocking_deadline_order.size();
              ++ordinal) {
             const auto piece = plan.blocking_deadline_order[ordinal];
             const auto priority = combined.find(piece);
@@ -1246,6 +1467,10 @@ void LibtorrentStreamBridge::handle_read_piece(const lt::read_piece_alert& alert
     impl_->handle_read_piece(alert);
 }
 
+void LibtorrentStreamBridge::handle_piece_finished(const lt::piece_finished_alert& alert) {
+    impl_->handle_piece_finished(alert);
+}
+
 std::string LibtorrentStreamBridge::stop_stream(const std::string& stream_id) {
     return impl_->stop_stream(stream_id);
 }
